            "import": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@hono/node-server": "^2.1.0",
        "hono": "^4.13.1"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "scripts": {
        "dev": "tsx examples/local-server.ts",
        "build": "tsdown src/index.mts",
        "test": "vitest run"
    }
}
