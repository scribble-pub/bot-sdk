{
    "name": "@scribble-pub/bot-sdk",
    "version": "0.2.0",
    "description": "The official Scribble.pub TypeScript bot SDK.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/scribble-pub/bot-sdk.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
